# Level Up - Environment Variables Template

# ============================================================================
# FOR COURSE CONTRIBUTORS (Testing course content only)
# ============================================================================
# Leave these BLANK to run in READ-ONLY mode
# - Courses load from local src/courses/ files
# - No authentication required
# - Perfect for testing course content before submitting PR
# ============================================================================

# ============================================================================
# FOR CORE DEVELOPERS (Building platform features)
# ============================================================================
# Fill in your Supabase credentials to test full platform features
# - User authentication
# - Progress tracking
# - Enrollments
# - Submissions
# 
# Get these from: https://supabase.com/dashboard
# Project Settings → API → Project URL and anon/public key
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
